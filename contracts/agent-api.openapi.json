        "parameters": [
          {
            "name": "profile",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/AgentProfile",
              "default": "customer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
