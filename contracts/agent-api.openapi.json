  "components": {
    "schemas": {
      "ActionOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "tool": {
            "type": "string",
            "title": "Tool"
          },
          "operation": {
            "type": "string",
            "enum": [
              "UPDATE",
              "SENSITIVE_UPDATE",
              "ACTION"
            ],
            "title": "Operation"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending_confirmation",
              "confirmed",
              "executing",
              "verified",
              "completed",
              "unverified",
              "failed",
              "cancelled",
              "expired"
            ],
            "title": "State"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "target": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Target"
          },
          "changes": {
            "items": {
              "$ref": "#/components/schemas/FieldChangeOut"
            },
            "type": "array",
            "title": "Changes"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "confirmation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConfirmationOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "verified": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verified"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "tool",
          "operation",
          "state",
          "summary",
          "target",
          "changes",
          "created_at",
          "updated_at"
        ],
        "title": "ActionOut"
      },
      "AgentProfile": {
        "type": "string",
        "enum": [
          "customer",
          "management"
        ],
        "title": "AgentProfile"
      },
      "AgentResponse": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "answer",
              "clarification",
              "confirmation_required",
              "action_result",
              "error"
            ],
            "title": "Type"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "blocks": {
            "items": {
              "$ref": "#/components/schemas/Block"
            },
            "type": "array",
            "title": "Blocks"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceOut"
            },
            "type": "array",
            "title": "Sources"
          },
          "action": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ActionOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "meta": {
            "$ref": "#/components/schemas/MetaOut"
          }
        },
        "type": "object",
        "required": [
          "type",
          "message",
          "session_id",
          "request_id",
          "meta"
        ],
        "title": "AgentResponse"
      },
      "Block": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "recommendation",
              "product_detail",
              "product_comparison",
              "inventory",
              "store_info",
              "branch_list",
              "workshop_list",
              "promotion_list",
              "policy",
              "knowledge",
              "taxonomy",
              "design_task",
              "candidates",
              "supplier_info",
              "order_status"
            ],
            "title": "Kind"
          },
          "data": {
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "data"
        ],
        "title": "Block",
        "description": "Dữ liệu có cấu trúc kèm câu trả lời. Hình dạng `data` theo `kind` — các kind mới có schema riêng:\n`supplier_info` → SupplierInfoBlockData, `order_status` → list[OrderStatusBlockData]."
      },
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Message",
            "description": "Tin nhắn người dùng (giới hạn thực tế theo MAX_MESSAGE_CHARS). Alias: `content`, `query`.",
            "x-aliases": [
              "content",
              "query"
            ]
          },
          "lat": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 90.0,
                "minimum": -90.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Lat",
            "description": "Vĩ độ GPS thiết bị (tùy chọn). Alias: `latitude`.",
            "examples": [
              10.7769
            ]
          },
          "lng": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 180.0,
                "minimum": -180.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Lng",
            "description": "Kinh độ GPS thiết bị (tùy chọn). Alias: `lon`, `longitude`.",
            "examples": [
              106.7009
            ]
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9_\\-:.]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id",
            "description": "Bỏ trống để server tạo phiên mới. Alias: `sessionId`.",
            "x-aliases": [
              "sessionId"
            ]
          },
          "client_message_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Message Id",
            "description": "Id phía client để chống gửi trùng. Alias: `clientMessageId`.",
            "x-aliases": [
              "clientMessageId"
            ]
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Location"
              },
              {
                "type": "null"
              }
            ],
            "description": "Vị trí thiết bị (chỉ dùng cho tìm xưởng gần)."
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest",
        "description": "Nhận cả snake_case và camelCase: `session_id`|`sessionId`, `client_message_id`|`clientMessageId`.\nNội dung: `message` hoặc `content` (Backend `SendAiMessageRequest{content, lat, lng}`) hoặc `query` (định dạng /chat cũ).\nVị trí: `lat`/`lng` ở cấp ngoài (Backend `SendAiMessageRequest`, `AdminAiChatRequest`) hoặc `location{lat,lng}`;\nnhận thêm `latitude`/`longitude`. Vị trí thiếu/không hợp lệ/giá trị mẫu (-90,-180), (0,0) bị bỏ qua (không lỗi 422)\n— Agent không giả định vị trí. Chỉ tìm xưởng gần cần vị trí.",
        "examples": [
          {
            "content": "tìm xưởng gần tôi",
            "lat": 10.7769,
            "lng": 106.7009
          },
          {
            "message": "tìm bàn học dưới 3 triệu"
          }
        ]
      },
      "ConfirmRequest": {
        "properties": {
          "confirmation_code": {
            "type": "string",
            "maxLength": 12,
            "minLength": 4,
            "title": "Confirmation Code",
            "description": "Alias: `confirmationCode`.",
            "x-aliases": [
              "confirmationCode"
            ]
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id",
            "description": "Alias: `sessionId`.",
            "x-aliases": [
              "sessionId"
            ]
          }
        },
        "type": "object",
        "required": [
          "confirmation_code"
        ],
        "title": "ConfirmRequest",
        "description": "Giữ cho tương thích Backend (/api/admin/ai-agent/actions/{id}/confirm). Agent CHỈ ĐỌC nên không còn action:\nluôn trả AgentResponse type=error, error.code=ACTION_NOT_FOUND. Nhận `confirmationCode`, `sessionId`."
      },
      "ConfirmationOut": {
        "properties": {
          "required": {
            "type": "boolean",
            "title": "Required"
          },
          "level": {
            "type": "string",
            "enum": [
              "standard",
              "strong"
            ],
            "title": "Level"
          },
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code",
            "description": "Mã người dùng phải gửi lại để xác nhận (chỉ trả cho chủ action)."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "confirm_endpoint": {
            "type": "string",
            "title": "Confirm Endpoint"
          },
          "cancel_endpoint": {
            "type": "string",
            "title": "Cancel Endpoint"
          },
          "chat_phrase": {
            "type": "string",
            "title": "Chat Phrase",
            "description": "Câu người dùng có thể gõ trong chat để xác nhận, vd 'xác nhận ABC123'."
          }
        },
        "type": "object",
        "required": [
          "required",
          "level",
          "expires_at",
          "confirm_endpoint",
          "cancel_endpoint",
          "chat_phrase"
        ],
        "title": "ConfirmationOut"
      },
      "ErrorOut": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
