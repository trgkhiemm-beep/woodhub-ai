# ---- WoodHub AI Agent ----
APP_ENV=local                       # local | test | staging | production
LOG_LEVEL=INFO

# Backend (source of truth). Bắt buộc.
BACKEND_BASE_URL=https://woodhub-be.onrender.com
BACKEND_TIMEOUT_SECONDS=8
BACKEND_MAX_RETRIES=2
BACKEND_KEEPALIVE_SECONDS=0          # vd 600: ping Backend 10 phút/lần để Render free không ngủ (0 = tắt)

# Auth: JWT do Backend phát hành (HS256). Đặt ĐÚNG bằng JWT_SECRET của Backend → AI service verify token tại chỗ.
# Bỏ trống → dự phòng xác thực qua Backend GET /api/users/me. KHÔNG commit giá trị thật.
BACKEND_JWT_SECRET=
BACKEND_JWT_LEEWAY_SECONDS=0

# NLU: auto (dùng LLM nếu có BEDROCK_MODEL_ID + AWS key) | llm | rules
NLU_MODE=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-2
BEDROCK_MODEL_ID=                   # model dùng cho NLU qua Converse API (đã kiểm thử: google.gemma-3-4b-it)

# CORS: danh sách origin phân tách bằng dấu phẩy (cấm '*' ở staging/production)
CORS_ORIGINS=http://localhost:3000

# Audit log (JSONL, append-only)
AUDIT_LOG_PATH=var/audit/audit.jsonl

# Chỉ dùng cho live test đối chiếu dữ liệu thật (read-only). Không cần cho runtime.
SUPABASE_URL=
SUPABASE_KEY=
